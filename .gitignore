# raw personal traces and large data stay local (privacy: don't publish home/hotel coords)
data/raw/*
!data/raw/.gitkeep
data/pems/*
!data/pems/.gitkeep
data/synthetic/*

# generated outputs (regenerated by run.py / run_sim.py)
figures/*.png
figures/*.json
# per-run output dirs (figures_sat/, figures_sun/, figures_realtest/, ...)
figures_*/
# generated SUMO inputs/outputs (regenerated by run_sim.py)
sim/out/*
!sim/out/.gitkeep

# python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
.DS_Store
